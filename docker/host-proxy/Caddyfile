# Host proxy for the production server (Caddy on the droplet, in front of the containers).
#
# Cloudflare sits in front of this server. The visitor's IP is believed ONLY when the request
# comes from Cloudflare (trusted_proxies), taken from CF-Connecting-IP, and then written into
# X-Real-IP — overwriting anything the visitor sent. The backend's nginx trusts X-Real-IP from
# this proxy only, and per-IP limits, M-Pesa callback IPs and the admin allow-list depend on it.
# Also firewall ports 80/443 to Cloudflare's ranges, so nobody can reach this server around it.
#
# TLS: Cloudflare "Full (strict)" with a Cloudflare Origin Certificate for the domain and
# *.domain (covers every shop's subdomain), saved on the server as below.
# Refresh the Cloudflare ranges from https://www.cloudflare.com/ips/ when they change.

{
	servers {
		trusted_proxies static 173.245.48.0/20 103.21.244.0/22 103.22.200.0/22 103.31.4.0/22 141.101.64.0/18 108.162.192.0/18 190.93.240.0/20 188.114.96.0/20 197.234.240.0/22 198.41.128.0/17 162.158.0.0/15 104.16.0.0/13 104.24.0.0/14 172.64.0.0/13 131.0.72.0/22 2400:cb00::/32 2606:4700::/32 2803:f800::/32 2405:b500::/32 2405:8100::/32 2a06:98c0::/29 2c0f:f248::/32
		client_ip_headers CF-Connecting-IP
		trusted_proxies_strict
	}
}

(origin_tls) {
	tls /etc/caddy/certs/origin.pem /etc/caddy/certs/origin-key.pem
}

(to_backend) {
	reverse_proxy 127.0.0.1:8080 {
		header_up X-Real-IP {client_ip}
		header_up -X-Forwarded-For
	}
}

# Central API and every shop's API ({workspace}.{$POACHY_DOMAIN}).
api.{$POACHY_DOMAIN}, *.{$POACHY_DOMAIN} {
	import origin_tls
	import to_backend
}

# The website (poachy-web, Next.js production server).
{$POACHY_DOMAIN}, www.{$POACHY_DOMAIN} {
	import origin_tls
	reverse_proxy 127.0.0.1:3000 {
		header_up X-Real-IP {client_ip}
	}
}

# The admin (poachy-admin) — staff only; also behind Cloudflare Access or an IP allow-list.
admin.{$POACHY_DOMAIN} {
	import origin_tls
	reverse_proxy 127.0.0.1:8100 {
		header_up X-Real-IP {client_ip}
	}
}
